# Variáveis de ambiente (exemplo)
# HTTP_TIMEOUT_MS=30000

# --- Bônus: classificação IA (opcional) ---
# Ativa enriquecimento com LLM após o scrape (requer OPENAI_API_KEY)
# ENABLE_AI_CLASSIFIER=true

# Chave da API OpenAI (ou compatível)
# OPENAI_API_KEY=sk-...

# URL e modelo (opcionais — padrão: OpenAI gpt-4o-mini)
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini

# Limite de livros enriquecidos por execução (padrão: 5 — evita custo alto)
# AI_MAX_BOOKS=5

# --- Bônus: browser automation (opcional) ---
# Demonstração Playwright para páginas com JS (não usado no scrape principal)
# ENABLE_BROWSER_SCRAPER=true

# URL alvo para npm run scrape:browser-demo (padrão: fixture local tests/fixtures/)
# BROWSER_SCRAPER_URL=file:///caminho/para/dynamic-catalog.html
