# Variáveis de ambiente (exemplo)
# HTTP_TIMEOUT_MS=30000

# --- Bônus: classificação IA (opcional) ---
# Ativa enriquecimento com LLM após o scrape (requer OPENAI_API_KEY)
# ENABLE_AI_CLASSIFIER=true

# Chave da API OpenAI (ou compatível)
# OPENAI_API_KEY=sk-...

# URL e modelo (opcionais — padrão: OpenAI gpt-4o-mini)
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini

# Limite de livros enriquecidos por execução (padrão: 5 — evita custo alto)
# AI_MAX_BOOKS=5
