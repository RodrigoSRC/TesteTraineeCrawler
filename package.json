{
  "name": "teste-trainee-crawler",
  "version": "1.0.0",
  "description": "Scraper modular em Node.js com TypeScript",
  "main": "output/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node output/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('output',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "scrape:browser-demo": "tsx src/browserDemo.ts"
  },
  "keywords": [
    "scraper",
    "crawler",
    "typescript"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "playwright": "^1.60.0",
    "ts-jest": "^29.4.10",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
